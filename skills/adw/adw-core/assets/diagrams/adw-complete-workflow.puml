@startuml adw-complete-workflow
!theme plain
title Agentic Delivery Workflow (ADW)

start

partition Human {
  :State feature, bugfix, release, incident, or audit intent;
}

partition "ADW Agent" {
  :Load adw-core and the stage-specific skill;
  :Inspect repository, adapter, manifest, issue/PR, and live state;
  if (Required value ambiguous?) then (yes)
    :Ask for the missing decision;
  endif
  if (Planning required?) then (yes)
    :Create or update plan, branch, issue, acceptance criteria, and rollback considerations;
  endif
}

partition Human {
  :Approve the implementation path when required;
  :Explicitly approve the exact PR source branch, target branch, and replacement/deletion effect;
  :For full rollout, approve the exact adapter-declared promotion and deployment route at this first confirmation;
}

partition "ADW Agent" {
  if (Delegated implementation?) then (yes)
    :Prepare backend-neutral delegation packet;
    :Receive verifiable branch/commit/PR and evidence;
    :Inspect returned diff independently;
  else (direct)
    :Implement only approved scope;
  endif
  :Run adw:check;
  :Run adw:verify:minimal;
  if (Manifest invalid or checks fail?) then (yes)
    :Report blocked/failed evidence;
    stop
  endif
  :Create or update the linked PR only for the approved exact route;
}

partition "Review Platform" {
  :PR links issue, plan, diff, validation evidence, and deployment notes;
  :Review and external checks run;
}

partition "ADW Agent" {
  if (PR rejected?) then (yes)
    :Stop and report remediation;
    stop
  endif
  if (Disposable preview declared?) then (yes)
    :Plan/apply preview configuration through canonical tasks;
    :Deploy and inspect canonical status evidence;
    :Run supported health, readiness, and deployment validation; optional E2E only with explicit run authorization;
  endif
  :Run adw:verify:full for release-class targets;
  if (Validation incomplete or failed?) then (yes)
    :Report no-go and remaining risk;
    stop
  endif
}

partition "ADW Agent" {
  if (Exact full-rollout grant still valid?) then (yes)
    :Recheck the exact target and every quality/review/preview gate; continue without repeat confirmation;
  else (no)
    :Request separate merge and deployment decisions for an ordinary chain, or renew an expired full-rollout grant;
  endif
}

partition Human {
  :For ordinary chains, explicitly approve exact merge target;
  :For ordinary chains, state whether deployment is requested and approve its exact target if so;
}

partition "ADW Agent" {
  :Merge without bypassing protection;
  :Verify destination revision;
  if (Deployment explicitly requested?) then (yes)
    :Resolve opaque environment from manifest and adapter;
    :Plan/apply configuration through canonical tasks;
    :Deploy through adw:deploy:apply;
    :Verify status, identity, health, readiness, E2E, and business semantics as supported;
    if (Deployment regression?) then (yes)
      :Preserve failed-state evidence;
      :Request exact rollback approval;
      :Use adapter-declared restore strategy and canonical deployment gates;
    endif
  else (no)
    :Record verified merge-only result;
  endif
  :Update issue/PR and report revision, evidence, target, risks, and next action;
}

stop
@enduml
